{
  "name": "casprflowos",
  "version": "0.0.0",
  "private": true,
  "description": "casprFlowOS — an agentic OS: an infinite canvas of AI coding agents, driven by voice and text.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @casprflowos/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
